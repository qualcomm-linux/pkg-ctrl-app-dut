#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_install:
	set -e; \
	mkdir -p debian/tmp; \
	test -d data/ctrl-app-dut || { echo "ERROR: data/ctrl-app-dut directory not found"; exit 1; }; \
	test -d data/ath11k-fwtest || { echo "ERROR: data/ath11k-fwtest directory not found"; exit 1; }; \
	cp -a data/ctrl-app-dut/. debian/tmp/; \
	cp -a data/ath11k-fwtest/. debian/tmp/
