#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_install:
	set -e; \
	. debian/upstream.conf; \
	mkdir -p debian/tmp; \
	curl -fL \
		-o debian/wlan-service.tar.gz \
		"$${ARTIFACTORY}/$${TAG}/$${DISTRO}/$${PACKAGE_NAME}"; \
	tar -xzf debian/wlan-service.tar.gz -C debian/tmp; \
	rm -f debian/wlan-service.tar.gz
